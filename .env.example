# ──────────────────────────────────────────────────────────────────────────────
# Attendance Portal — Environment Variables Example
#
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────────────────────
# Your project URL from https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon/public key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — server-only, grants bypass of RLS. NEVER expose client-side.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── WebAuthn / Passkeys (required in production) ──────────────────────────────
# The Relying Party ID — must be your hostname without port.
# e.g. "attendance-portal-jade.vercel.app" or "localhost" for local dev.
NEXT_PUBLIC_WEBAUTHN_RP_ID=localhost

# The canonical origin of the app (protocol + host + optional port).
# e.g. "https://attendance-portal-jade.vercel.app" or "http://localhost:3000"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Rotating QR session token ─────────────────────────────────────────────────
# Minimum 32-character random secret used to sign rotating QR tokens.
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-at-least-32-random-characters!

# ── Vercel (auto-injected, leave blank locally) ───────────────────────────────
# VERCEL_URL=
